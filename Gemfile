source "https://rubygems.org"

# Official GitHub Pages gem set — used by Actions-based deployments and local
# `bundle exec jekyll serve`. When deploying via "Deploy from a branch",
# GitHub Pages builds with its own pinned jekyll/github-pages versions, so a
# Gemfile is optional (see https://pages.github.com/versions/).
gem "github-pages", group: :jekyll_plugins
gem "webrick"